# QuickPNG-Tinize4Web 変換設定
# Claude・scripts/tinize.py の両方がこの値を参照する

# 縮小の基準となる長辺の最大px。横または縦の長い方がこの値を超える場合のみ縮小する。
# アスペクト比は常に維持し、元がこの値以下なら拡大せずそのまま出力する。
MAX_EDGE=1180

# 高圧縮のためのパレット色数(2-256)。少ないほど軽量・画質は低下。256を推奨既定とする。
# 0 = 量子化しない（QUANTIZE=0 と同じ。COLOR_BITS が有効ならそれを適用）。
PALETTE_COLORS=256

# ディザリング(1=有効/0=無効)。有効にするとグラデーションが滑らかになるがサイズは微増。
DITHER=1

# oxipngの最適化レベル(0-6)。6が最も高圧縮(処理は遅め)。
OXIPNG_LEVEL=6

# パレット量子化を行うか(1=行う/0=行わずに可逆圧縮のみ)。
# 1=256色パレットで最大圧縮(グラデーションにバンディングが出やすい)。
QUANTIZE=1

# 中間設定: truecolor(色数)を保ったまま各チャンネルのビット深度を落として圧縮する。
# 0または8=無効(フル8bit)。5/6/7を指定するとそのビット数へ量子化。
#   7bit=ほぼ無劣化 / 6bit=高品質(推奨バランス) / 5bit=やや軽量。
# QUANTIZE=1 のときは無視される。色を保ちつつ軽くしたい場合は QUANTIZE=0 かつ COLOR_BITS=6。
COLOR_BITS=0

# --- 任意の後段: iLoveAPI (iLoveIMG) compressimage で出力PNGをさらに圧縮する ---
# 1=有効 / 0=無効。有効時は変換スクリプトの末尾で scripts/iloveapi_compress.py が自動実行される。
ILOVEAPI_COMPRESS=0
# https://www.iloveapi.com/ で発行した Public key（無料枠 月2,500クレジット。1画像=1クレジット目安）
ILOVEAPI_PUBLIC_KEY=
# 圧縮強度: low / recommended / extreme
ILOVEAPI_LEVEL=recommended
